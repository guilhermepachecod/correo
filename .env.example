# correo — variáveis de ambiente
# Copie para .env e preencha. Gere SECRET_KEY e FERNET_KEY com:
#   python scripts/gen_keys.py
# Gere PASSWORD_HASH com:
#   python scripts/hash_password.py

# ── Segurança (obrigatórias — o app recusa subir sem elas) ───────────────────
CORREO_SECRET_KEY=
CORREO_FERNET_KEY=
CORREO_USER=
CORREO_PASSWORD_HASH=

# ── Origens permitidas no Socket.IO, separadas por vírgula ──────────────────
# Ex.: https://cypht.soft.dev.br:18443
CORREO_ALLOWED_ORIGINS=

# true quando atrás de HTTPS (Caddy em produção); false para http local
CORREO_COOKIE_SECURE=false

# ── Limites e diretórios (opcionais — têm default no código, usado no Docker) ─
MAX_ACCOUNTS=20
ATTACHMENTS_DIR=/app/database/attachments
# ACCOUNTS_DIR=/app/accounts
# CORREO_DATABASE_URI=sqlite:////app/database/mail.db

# ── Sincronização (Fase 2, opcionais — têm default no código) ───────────────
# Poda de corpo (não apaga a mensagem, só o corpo em cache — Fase 2.7)
# CORREO_MAX_BODIES_PER_ACCOUNT=2000
# CORREO_BODY_RETENTION_DAYS=180
# Intervalo de poll das pastas sem IDLE (sent/trash/junk/drafts/archive)
# CORREO_POLL_SECONDS=120

# ── Outros ────────────────────────────────────────────────────────────────
TZ=America/Sao_Paulo
